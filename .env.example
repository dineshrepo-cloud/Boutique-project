# ==============================================================================
# Yuka Trendz Boutique - Environment Configuration Example
# Copy this file to .env.local and update with your credentials
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session Cryptographic Secret
SESSION_SECRET=yuka-trendz-cryptographic-vault-key-2026

# Google OAuth 2.0 Credentials (Sign In with Google)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Database Connection (Neon Serverless PostgreSQL - optional)
# DATABASE_URL=postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# Razorpay Payment Gateway Credentials
# ==============================================================================
# Get these from: Razorpay Dashboard -> Account & Settings -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
