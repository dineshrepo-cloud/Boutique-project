# Neon PostgreSQL Connection String (Pooler or Direct)
# Example: postgres://username:password@ep-sample-12345-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ==============================================================================
# Google OAuth 2.0 / OpenID Connect Credentials
# ==============================================================================
# 1. Create a project at Google Cloud Console (https://console.cloud.google.com).
# 2. Navigate to "APIs & Services" > "OAuth consent screen", set User Type to External.
# 3. Navigate to "Credentials" > "Create Credentials" > "OAuth client ID".
# 4. Set Application Type to "Web application".
# 5. Add Authorized JavaScript origins:
#    - http://localhost:3000
# 6. Add Authorized redirect URIs:
#    - http://localhost:3000/api/auth/google/callback
# 7. Copy Client ID and Client Secret below:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base public application URL (used for OAuth redirect URI resolution in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cryptographic secret for signing HMAC SHA-256 session tokens and OAuth state cookies
SESSION_SECRET=yuka-trendz-cryptographic-vault-key-2026
